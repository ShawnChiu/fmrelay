[Unit]
Description=org.freedesktop.FileManager1 relay to a custom command
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Not Type=dbus: while another file manager owns the name, fmrelay waits in the bus queue,
# and systemd would time out waiting for the name and kill it.
Type=exec
# Example command; change it to your file manager.
ExecStart=%h/.cargo/bin/fmrelay --folders 'ghostty -e yazi {}'
Restart=on-failure
# The default (control-group) would close every window fmrelay opened when it stops or
# restarts.
KillMode=process

[Install]
WantedBy=graphical-session.target
